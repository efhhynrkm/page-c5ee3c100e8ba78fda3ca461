          "version": 3,
          "body": "<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml{font-size:16px}\nbody{margin:0;font-family:-apple-system,BlinkMacSystemFont,\"Helvetica Neue\",\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;color:#1a1a1a;background:#ffffff;line-height:1.7;-webkit-font-smoothing:antialiased}\na{color:#1a1a1a;text-decoration:none;border-bottom:1px solid transparent}\na:hover{border-bottom-color:#ff5a1f}\nh1,h2,h3,h4{font-weight:700;letter-spacing:-.01em;margin:0 0 .6em;color:#0a0a0a}\nh1{font-size:clamp(2.4rem,5.5vw,4.2rem);line-height:1.05;letter-spacing:-.03em}\nh2{font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.2;margin-top:2.4em}\nh3{font-size:1.15rem;margin-top:1.6em}\np{margin:0 0 1em}\nul,ol{margin:0 0 1.2em;padding-left:1.4em}\nli{margin-bottom:.4em}\n.wrap{max-width:1180px;margin:0 auto;padding:0 28px}\n\n/* Brand strip nav (no top bar, jumps inside page) */\n.brandstrip{display:flex;align-items:center;justify-content:space-between;padding:22px 0 12px;border-bottom:2px solid #ff5a1f}\n.brandstrip .logo{font-weight:800;letter-spacing:.18em;font-size:1.05rem;color:#0a0a0a}\n.brandstrip .jumps{display:flex;gap:18px;flex-wrap:wrap}\n.brandstrip .jumps a{font-size:.88rem;color:#3a3a3a;border-bottom:1px dashed transparent;padding-bottom:2px}\n.brandstrip .jumps a:hover{border-bottom-color:#ff5a1f;color:#ff5a1f}\n\n/* Hero: full-width color bands stacked */\n.hero{position:relative;margin:18px 0 0}\n.band{padding:54px 0;color:#0a0a0a}\n.band-a{background:#ffffff}\n.band-b{background:#ffe7d6}\n.band-c{background:#ff5a1f;color:#ffffff}\n.band-d{background:#0a0a0a;color:#ffffff}\n.band-inner{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;flex-wrap:wrap}\n.eyebrow{display:inline-block;padding:6px 12px;border:1px dashed currentColor;font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;margin-bottom:18px}\n.hero h1 .line2{display:block;color:#ff5a1f}\n.band-c h1,.band-c .eyebrow{color:#ffffff;border-color:#ffffff}\n.band-d h1,.band-d .eyebrow{color:#ffffff;border-color:#ffffff}\n.hero .meta{display:flex;gap:32px;flex-wrap:wrap;font-size:.92rem}\n.hero .meta div{min-width:140px}\n.hero .meta span{display:block;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;opacity:.7;margin-bottom:4px}\n.band-c .meta,.band-d .meta{color:#ffffff}\n.band-c .meta span,.band-d .meta span{opacity:.75}\n\n/* Section base */\nsection{padding:64px 0;border-bottom:1px solid #f0f0f0}\nsection:last-of-type{border-bottom:none}\n.lead{max-width:780px;color:#2c2c2c;font-size:1.02rem}\n\n/* Ticket / dashed card */\n.ticket{position:relative;background:#ffffff;border:1.5px dashed #1a1a1a;border-radius:10px;padding:22px 22px 20px;margin-bottom:18px}\n.ticket .tag{display:inline-block;background:#ff5a1f;color:#fff;font-size:.7rem;letter-spacing:.14em;padding:3px 8px;border-radius:3px;text-transform:uppercase;margin-bottom:8px}\n.ticket h3{margin-top:0;color:#0a0a0a}\n.ticket .row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:.88rem;color:#3a3a3a;padding-top:10px;margin-top:14px;border-top:1px dashed #cfcfcf}\n.ticket .row span b{color:#0a0a0a}\n\n/* Plans comparison table */\n.plans{overflow-x:auto;border:1.5px dashed #1a1a1a;border-radius:10px;background:#ffffff}\n.plans table{width:100%;border-collapse:collapse;min-width:720px}\n.plans th,.plans td{padding:18px 16px;text-align:left;vertical-align:top;border-bottom:1px dashed #d0d0d0;font-size:.92rem}\n.plans thead th{background:#0a0a0a;color:#ffffff;font-weight:700;letter-spacing:.04em;font-size:.85rem;text-transform:uppercase}\n.plans thead th.feat{background:#ffe7d6;color:#0a0a0a}\n.plans td.plan{font-weight:700;color:#0a0a0a;background:#fff7f0}\n.plans td.price{font-weight:700;color:#ff5a1f;font-size:1.05rem}\n.plans tr.recommended td.plan{background:#ff5a1f;color:#ffffff}\n.plans tr.recommended td.price{color:#ffffff;background:#ff5a1f}\n.plans .check{color:#0a0a0a;font-weight:700}\n.plans .dash{color:#b8b8b8}\n\n/* Steps */\n.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}\n.step{border:1.5px dashed #1a1a1a;border-radius:10px;padding:22px;background:#ffffff;position:relative}\n.step .n{font-size:2.4rem;font-weight:800;color:#ff5a1f;line-height:1;letter-spacing:-.04em;display:block;margin-bottom:10px}\n.step h3{margin:0 0 8px;font-size:1.02rem}\n.step p{font-size:.9rem;color:#3a3a3a;margin:0}\n\n/* FAQ two columns */\n.faq{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}\n.faq details{border:1.5px dashed #1a1a1a;border-radius:10px;padding:16px 18px;background:#ffffff}\n.faq summary{cursor:pointer;font-weight:700;color:#0a0a0a;font-size:.98rem;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary:after{content:\"+\";color:#ff5a1f;font-size:1.4rem;font-weight:400;line-height:1}\n.faq details[open] summary:after{content:\"–\"}\n.faq .ans{margin-top:12px;color:#2c2c2c;font-size:.92rem}\n.faq .ans p{margin:0 0 .6em}\n.faq .ans ul{margin:.4em 0 .8em;padding-left:1.2em}\n\n/* Support grid */\n.support{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}\n\n/* Footer */\nfooter{padding:36px 0 56px;border-top:1px solid #f0f0f0;color:#666;font-size:.82rem}\nfooter .row{display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px}\n\n@media (max-width:720px){\n  .brandstrip{flex-direction:column;align-items:flex-start;gap:10px}\n  .hero .meta{flex-direction:column;gap:14px}\n  .band-inner{flex-direction:column;align-items:flex-start}\n  .faq{grid-template-columns:1fr}\n  .plans th,.plans td{padding:12px 10px;font-size:.85rem}\n}\n</style><div class=\"wrap\">\n\n<header class=\"brandstrip\" aria-label=\"品牌标识与页内跳转\">\n  <div class=\"logo\">ITSS</div>\n  <nav class=\"jumps\" aria-label=\"页内导航\">\n    <a href=\"#about\">关于</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#steps\">接入步骤</a>\n    <a href=\"#faq\">常见问题</a>\n    <a href=\"#support\">支持</a>\n  </nav>\n</header>\n\n<main>\n\n<section class=\"hero\" aria-label=\"ITSS 首屏\">\n  <div class=\"band band-a\">\n    <div class=\"band-inner\">\n      <div>\n        <span class=\"eyebrow\">ITSS · 订阅说明页</span>\n        <h1>ITSS<br><span class=\"line2\">把节点、流量和设备数，写在一张看得懂的清单里。</span></h1>\n      </div>\n      <div class=\"meta\">\n        <div><span>适用平台</span>通用说明</div>\n        <div><span>结算方式</span>月付 / 年付</div>\n        <div><span>阅读时长</span>约 5 分钟</div>\n      </div>\n    </div>\n  </div>\n  <div class=\"band band-b\">\n    <div class=\"band-inner\">\n      <div>\n        <span class=\"eyebrow\">本页内容</span>\n        <h2>三档订阅 · 五项接入步骤 · 一组常见问题</h2>\n      </div>\n      <div class=\"meta\">\n        <div><span>信息更新</span>以本文档为准</div>\n        <div><span>价格单位</span>人民币 元</div>\n      </div>\n    </div>\n  </div>\n  <div class=\"band band-c\">\n    <div class=\"band-inner\">\n      <div>\n        <span class=\"eyebrow\">阅读方式</span>\n        <h2>按需查阅 · 不必从头读到尾</h2>\n      </div>\n      <div class=\"meta\">\n        <div><span>建议入口</span>套餐对比</div>\n        <div><span>下一步</span>接入步骤</div>\n      </div>\n    </div>\n  </div>\n  <div class=\"band band-d\">\n    <div class=\"band-inner\">\n      <div>\n        <span class=\"eyebrow\">使用前提</span>\n        <h2>请遵守当地法律法规与服务条款</h2>\n      </div>\n      <div class=\"meta\">\n        <div><span>文档版本</span>v1</div>\n        <div><span>品牌</span>ITSS</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"about\" aria-label=\"关于 ITSS\">\n  <h2>关于 ITSS</h2>\n  <p class=\"lead\">ITSS 提供订阅形式的网络接入服务，按月或按年结算。本页用于整理三档套餐的费用、流量额度与设备数限制，方便用户在不阅读冗长宣传文案的情况下，完成选型与下单。</p>\n  <div class=\"support\">\n    <div class=\"ticket\">\n      <span class=\"tag\">计费</span>\n      <h3>月付与年付</h3>\n      <p>同一档套餐提供月付与年付两种结算周期。年付按 10 个月价格折算，相对月付更划算，适合长期使用的用户。</p>\n      <div class=\"row\"><span>结算单位：<b>人民币 元</b></span><span>周期：<b>30 天 / 365 天</b></span></div>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">流量</span>\n      <h3>月度流量额度</h3>\n      <p>每档套餐设有月度流量上限。流量按自然月计算，未使用部分不结转至下一个月，请在每月初关注剩余额度。</p>\n      <div class=\"row\"><span>计量方式：<b>上行 + 下行</b></span><span>周期：<b>自然月</b></span></div>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">设备</span>\n      <h3>同时在线设备数</h3>\n      <p>同时在线设备数指同一账号下可并行连接的设备数量。超出数量后新设备会顶替最早接入的设备。</p>\n      <div class=\"row\"><span>统计维度：<b>同时在线</b></span><span>超出处理：<b>顶替最早连接</b></span></div>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">节点</span>\n      <h3>线路与节点池</h3>\n      <p>不同套餐接入的节点池不同。基础版使用普通线路节点池；旗舰版额外提供 IPLC 专线；团队版开放高带宽节点与企业定制路由。</p>\n      <div class=\"row\"><span>基础版：<b>普通线路</b></span><span>旗舰版：<b>+ IPLC 专线</b></span></div>\n    </div>\n  </div>\n</section>\n\n<section id=\"plans\" aria-label=\"套餐对比\">\n  <h2>套餐对比</h2>\n  <p class=\"lead\">以下表格按横向对比方式列出三档套餐的价格、流量、设备数与节点能力。表中每一项均与下方功能列表一一对应，建议在选择前逐行阅读。</p>\n  <div class=\"plans\" role=\"region\" aria-label=\"ITSS 套餐对比表\">\n    <table>\n      <thead>\n        <tr>\n          <th class=\"feat\">对比项</th>\n          <th>基础版</th>\n          <th>旗舰版（推荐）</th>\n          <th>团队版</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <th>月付价格</th>\n          <td class=\"plan\">基础版</td>\n          <td class=\"plan\">旗舰版</td>\n          <td class=\"plan\">团队版</td>\n        </tr>\n        <tr>\n          <th>月付费用</th>\n          <td class=\"price\">¥15 / 月</td>\n          <td class=\"price\">¥35 / 月</td>\n          <td class=\"price\">¥85 / 月</td>\n        </tr>\n        <tr>\n          <th>年付费用</th>\n          <td>按年付仅需 ¥150 / 年</td>\n          <td>按年付仅需 ¥350 / 年</td>\n          <td>按年付仅需 ¥850 / 年</td>\n        </tr>\n        <tr class=\"recommended\">\n          <th>推荐场景</th>\n          <td>轻度浏览、临时使用</td>\n          <td>日常多设备、流媒体与游戏</td>\n          <td>多人共用、企业内协作</td>\n        </tr>\n        <tr>\n          <th>月度流量</th>\n          <td><span class=\"check\">每月 100GB 极速流量</span></td>\n          <td><span class=\"check\">每月 300GB 极速流量</span></td>\n          <td><span class=\"check\">每月 1000GB 极速流量</span></td>\n        </tr>\n        <tr>\n          <th>同时在线设备数</th>\n          <td><span class=\"check\">支持 3 台设备同时在线</span></td>\n          <td><span class=\"check\">支持 5 台设备同时在线</span></td>\n          <td><span class=\"check\">支持 20 台设备同时在线</span></td>\n        </tr>\n        <tr>\n          <th>流媒体解锁</th>\n          <td>解锁基础流媒体</td>\n          <td>全节点原生流媒体解锁</td>\n          <td>全节点原生流媒体解锁</td>\n        </tr>\n        <tr>\n          <th>节点线路</th>\n          <td>普通线路节点池</td>\n          <td>普通线路 + IPLC 专线游戏加速优化</td>\n          <td>VIP 专属高带宽节点 + 企业定制路由</td>\n        </tr>\n        <tr>\n          <th>技术支持</th>\n          <td>标准工单支持</td>\n          <td>7x24 优先工单支持</td>\n          <td>专属客户经理服务</td>\n        </tr>\n        <tr>\n          <th>企业定制</th>\n          <td><span class=\"dash\">—</span></td>\n          <td><span class=\"dash\">—</span></td>\n          <td>支持企业定制路由</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n  <h3>套餐功能一览</h3>\n  <div class=\"support\">\n    <div class=\"ticket\">\n      <span class=\"tag\">基础版</span>\n      <h3>基础版 · ¥15 / 月</h3>\n      <ul>\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n      <div class=\"row\"><span>年付：<b>¥150 / 年</b></span><span>定位：<b>轻度使用</b></span></div>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">推荐</span>\n      <h3>旗舰版 · ¥35 / 月</h3>\n      <ul>\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n      <div class=\"row\"><span>年付：<b>¥350 / 年</b></span><span>定位：<b>日常主力</b></span></div>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">团队版</span>\n      <h3>团队版 · ¥85 / 月</h3>\n      <ul>\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n      <div class=\"row\"><span>年付：<b>¥850 / 年</b></span><span>定位：<b>多人共用</b></span></div>\n    </div>\n  </div>\n</section>\n\n<section id=\"steps\" aria-label=\"接入步骤\">\n  <h2>接入步骤</h2>\n  <p class=\"lead\">以下步骤描述从选购套餐到在客户端完成连接的通用流程。具体客户端界面以你使用的软件为准。</p>\n  <ol class=\"steps\">\n    <li class=\"step\">\n      <span class=\"n\">01</span>\n      <h3>选择套餐</h3>\n      <p>根据设备数量、流量预估与是否需要流媒体或专线，决定基础版、旗舰版或团队版。</p>\n    </li>\n    <li class=\"step\">\n      <span class=\"n\">02</span>\n      <h3>完成支付</h3>\n      <p>下单后选择月付或年付，按页面提示完成支付。支付成功后会收到订阅信息。</p>\n    </li>\n    <li class=\"step\">\n      <span class=\"n\">03</span>\n      <h3>获取订阅链接</h3>\n      <p>在用户中心复制与你套餐对应的订阅链接，请勿将链接公开分享。</p>\n    </li>\n    <li class=\"step\">\n      <span class=\"n\">04</span>\n      <h3>导入客户端</h3>\n      <p>打开本地客户端，将订阅链接粘贴至“订阅设置”或“Profiles”位置，保存并更新。</p>\n    </li>\n    <li class=\"step\">\n      <span class=\"n\">05</span>\n      <h3>选择节点并连接</h3>\n      <p>在节点列表中选择与你套餐对应的线路，点击连接。连接成功后客户端会显示已用流量与剩余流量。</p>\n    </li>\n  </ol>\n</section>\n\n<section id=\"faq\" aria-label=\"常见问题\">\n  <h2>常见问题</h2>\n  <p class=\"lead\">下列问题按双栏形式整理，左栏为套餐与计费，右栏为连接与设备。如未覆盖你的问题，请查看下方支持入口。</p>\n  <div class=\"faq\">\n\n    <details>\n      <summary>套餐之间可以随时切换吗？</summary>\n      <div class=\"ans\">\n        <p>可以在用户中心提交套餐变更申请。升级通常即时生效，剩余周期按差价补足；降级会在当前周期结束后于下个周期生效。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>月付与年付哪个更划算？</summary>\n      <div class=\"ans\">\n        <p>年付按 10 个月价格折算，相对月付节省约 17%。如果计划使用超过 10 个月，建议直接选择年付。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>流量用完后会怎样？</summary>\n      <div class=\"ans\">\n        <p>当月流量达到上限后，连接会暂时中断，下个月 1 日自动恢复。未使用流量不结转。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>如何查看剩余流量与到期时间？</summary>\n      <div class=\"ans\">\n        <p>登录用户中心后，首页会显示本月已用流量、剩余流量与本次订阅的到期时间。客户端底部状态栏通常也会显示用量。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>同时在线设备数超出后会怎样？</summary>\n      <div class=\"ans\">\n        <p>新设备接入时，最早接入的一台会被踢下线，其余设备不受影响。建议在常用设备数量内使用。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>支持哪些客户端？</summary>\n      <div class=\"ans\">\n        <p>订阅链接兼容主流通用客户端。具体客户端名称与下载方式以你使用的客户端文档为准，本页不提供第三方下载链接。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>旗舰版相比基础版多了哪些能力？</summary>\n      <div class=\"ans\">\n        <p>流量从 100GB 提升到 300GB，设备数从 3 台提升到 5 台，新增全节点原生流媒体解锁与 IPLC 专线游戏加速优化，并提供 7x24 优先工单支持。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>团队版适合什么样的使用场景？</summary>\n      <div class=\"ans\">\n        <p>团队版提供每月 1000GB 流量、20 台设备同时在线、VIP 专属高带宽节点，并支持企业定制路由与专属客户经理，适合多人共用或团队协作。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>可以申请退款吗？</summary>\n      <div class=\"ans\">\n        <p>退款政策以购买时页面的服务条款为准。建议在下单前阅读条款，并在使用初期确认服务可用性。</p>\n      </div>\n    </details>\n\n    <details>\n      <summary>连接不稳定时如何排查？</summary>\n      <div class=\"ans\">\n        <ul>\n          <li>在客户端手动更新订阅，使本地节点列表与服务端保持一致。</li>\n          <li>切换至同一套餐内的其他节点，定位是否为单点问题。</li>\n          <li>检查本地网络与防火墙设置，确认未拦截客户端流量。</li>\n        </ul>\n      </div>\n    </details>\n\n  </div>\n</section>\n\n<section id=\"support\" aria-label=\"支持入口\">\n  <h2>支持入口</h2>\n  <p class=\"lead\">如套餐、计费或连接问题在本页未找到答案，可通过下列方式获取进一步帮助。</p>\n  <div class=\"support\">\n    <div class=\"ticket\">\n      <span class=\"tag\">工单</span>\n      <h3>提交工单</h3>\n      <p>在用户中心填写问题描述与订单号，旗舰版与团队版享受优先处理。</p>\n      <div class=\"row\"><span>响应：<b>按套餐等级</b></span><span>渠道：<b>用户中心</b></span></div>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">文档</span>\n      <h3>查阅说明</h3>\n      <p>本页包含套餐、接入与常见问题，建议先阅读本页内容再联系支持。</p>\n      <div class=\"row\"><span>位置：<b>本页 FAQ</b></span><span>维护：<b>ITSS</b></span></div>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">团队</span>\n      <h3>专属经理</h3>\n      <p>团队版用户配有专属客户经理，可处理定制路由、批量开通等事务。</p>\n      <div class=\"row\"><span>适用：<b>团队版</b></span><span>渠道：<b>用户中心分配</b></span></div>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"row\">\n    <div>© ITSS · 本页面用于整理订阅说明信息</div>\n    <div>请遵守当地法律法规与服务条款</div>\n  </div>\n</footer>\n\n</div>",
